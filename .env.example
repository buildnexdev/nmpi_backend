PORT=5000
NODE_ENV=development

DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=org_platform_db
DATABASE_USER=root
DATABASE_PASSWORD=

JWT_SECRET=super_secret_jwt_key_2026_community_platform
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_2026
JWT_REFRESH_EXPIRES_IN=30d

UPLOAD_PROVIDER=local
UPLOAD_DIR=uploads

# When AWS_S3_BUCKET is set, uploads go to S3 instead of local disk.
# Live should set these; omit AWS_S3_BUCKET to keep files on disk.
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
MOBILE_API_URL=http://localhost:5000
